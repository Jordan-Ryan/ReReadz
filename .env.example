# Optional: override Supabase config (defaults are in src/integrations/supabase/client.ts)
# EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Stripe (required for in-app card payments; get from Stripe Dashboard)
# EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Optional: Supabase storage bucket name for profile avatars (default: avatars)
# EXPO_PUBLIC_AVATAR_BUCKET=avatars
